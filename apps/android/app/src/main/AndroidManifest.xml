<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PropertyVaultApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PropertyVault">
        <!-- allowBackup=false: a session token in EncryptedSharedPreferences must never end up in
             an Android auto-backup archive on another device (NATIVE_ANDROID_SPEC.md §13's
             "device-only, never synced" rule, the same guarantee iOS's Keychain
             ThisDeviceOnly flag gives). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PropertyVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

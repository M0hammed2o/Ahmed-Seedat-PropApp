<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ProplystApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proplyst">
        <!-- allowBackup=false: a session token in EncryptedSharedPreferences must never end up in
             an Android auto-backup archive on another device (NATIVE_ANDROID_SPEC.md §13's
             "device-only, never synced" rule, the same guarantee iOS's Keychain
             ThisDeviceOnly flag gives). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Proplyst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links (Android V1 commercial-launch pass, WORKLOG.md this date,
                 Phase 9). android:autoVerify="true" makes Android check
                 https://proplyst.co.za/.well-known/assetlinks.json before treating a link as
                 app-owned; that endpoint currently returns an empty `statements` array (no
                 signing fingerprint configured yet, apps/admin's own honest-fallback design),
                 so verification will not succeed and every one of these links falls through to
                 the browser/PWA until Mohammed provides the real SHA-256 (see this pass's final
                 report). The intent-filter itself is still correct groundwork; once the
                 fingerprint is added server-side, verification starts succeeding with zero
                 Android-side change. android:launchMode="singleTask" so a link tapped while the
                 app is already running is delivered to the same MainActivity instance via
                 onNewIntent(), not a second stacked copy. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="proplyst.co.za" />
            </intent-filter>
        </activity>

        <!-- Invoice V1 completion pass (WORKLOG.md this date): GET /api/v1/invoices/:id/pdf
             requires this app's own Bearer auth header (unlike documents.signedUrl, a pre-signed
             Storage URL openable directly in a browser), so the PDF is downloaded once,
             authenticated, to a cache file, then opened via a content:// URI through the system's
             own PDF viewer. A raw file:// Uri is blocked by FileUriExposedException on modern
             Android; grantUriPermissions scopes read access to only the launched viewer app, for
             only that one file, never the whole cache directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="za.co.proplyst.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) backup and device-to-device transfer rules (2026-09-14, Android release P0).
     android:allowBackup="false" stops cloud backup, but for an app targeting API 31+ it no longer
     stops device-to-device transfer. A transferred copy of the encrypted session file cannot be
     decrypted on the new device (Keystore keys never migrate), so nothing of this app's local state
     is extracted in either direction: the app is a thin client, and a new device signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

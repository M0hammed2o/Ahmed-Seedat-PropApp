<?xml version="1.0" encoding="utf-8"?>
<!-- Scopes FileProvider access to exactly the cache subdirectories that need a content:// URI
     handed to another app/component, not the whole app cache directory, which also holds
     maintenance/proof-of-payment upload temp files from
     PostgrestMaintenanceRepository/WebApiPaymentReportsRepository (those never need a URI outside
     this process, so they stay unexposed). "captures/" is new (V1 utilities/rates/levies/budgets
     continuation pass): where a camera-capture intent writes an expense/utility-bill evidence
     photo before it is uploaded. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="invoices" path="invoices/" />
    <cache-path name="captures" path="captures/" />
</paths>

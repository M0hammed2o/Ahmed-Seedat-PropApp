# Demo mode drives the entire app from realistic in-memory mock data — no Supabase project
# required. BOTH variables below are required to activate it (SECURITY.md "Demo-mode auth
# bypass" — fixed 2026-07-30, PRODUCTION_READINESS_REPORT.md R-01). EXPO_PUBLIC_ALLOW_DEMO_MODE
# is fine here for local dev; the `production` EAS build profile (eas.json) deliberately never
# sets it, so production builds cannot activate demo mode regardless of this file.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_ALLOW_DEMO_MODE=true

EXPO_PUBLIC_SUPABASE_URL=https://TO_BE_CONFIRMED.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TO_BE_CONFIRMED
EXPO_PUBLIC_SUBSCRIPTION_MODE=mock
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

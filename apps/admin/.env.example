# Demo mode drives the entire dashboard from realistic mock data — no Supabase project
# required, and login accepts any credentials. BOTH variables below are required to activate it
# (SECURITY.md "Demo-mode auth bypass" — fixed 2026-07-30, PRODUCTION_READINESS_REPORT.md R-01).
# ALLOW_DEMO_MODE is an infra-level-only gate: it is fine here in a LOCAL .env file, but must
# NEVER be set in any staging/production hosting-platform environment configuration.
NEXT_PUBLIC_DEMO_MODE=true
ALLOW_DEMO_MODE=true

# Base URL used to build links inside outbound emails (invite acceptance, password reset). No
# hosting platform is chosen yet -- set to the real deployed origin once one is.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://TO_BE_CONFIRMED.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TO_BE_CONFIRMED
# Server-only — never prefix with NEXT_PUBLIC_, never send to the browser (SECURITY.md).
SUPABASE_SERVICE_ROLE_KEY=TO_BE_CONFIRMED
ADMIN_SESSION_COOKIE_SECRET=CHANGE_ME_32_CHAR_MINIMUM_RANDOM_VALUE
REVENUECAT_WEBHOOK_SECRET=
DOCUMENT_INTELLIGENCE_WEBHOOK_SECRET=
# Bearer secret for the production scheduler to call /api/v1/system/** job-runner endpoints
# without a platform-admin session. Leave unset in local/dev — those endpoints still work via an
# authenticated super_admin session with no secret configured.
CRON_JOB_SECRET=

# PayFast (Stage 4 commercial-launch execution plan, TECHNICAL_DEBT_REGISTER.md TD-36). All three
# required together to activate the real gateway (getBillingGatewayProvider()); unset = billing
# falls back to MockBillingGatewayProvider, same "no real vendor account = mock" pattern as
# OCR/email/WhatsApp. No real PayFast merchant account has been provisioned in this environment --
# get sandbox credentials at developers.payfast.co.za before setting these for real testing.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 'sandbox' (default if unset) or 'live'.
PAYFAST_MODE=sandbox

# Resend (Stage 5 commercial-launch execution plan, TECHNICAL_DEBT_REGISTER.md TD-37). Both
# required together to activate the real EmailProvider; unset = falls back to MockEmailProvider.
# No real Resend account exists in this environment -- get an API key + verify a sending domain
# at resend.com before setting these for real testing.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Meta WhatsApp Cloud API, direct -- no BSP middleman (Stage 5, TECHNICAL_DEBT_REGISTER.md TD-38).
# All three required together to activate the real WhatsAppProvider; unset = falls back to
# MockWhatsAppProvider. No real Meta Business/WhatsApp Business Platform account exists in this
# environment -- see developers.facebook.com/docs/whatsapp/cloud-api/get-started before setting
# these for real testing.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
# Meta template-approval language code. No documented per-org convention exists yet -- defaults to
# en_US if unset; override if the org's approved templates use a different locale.
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# AWS Textract (Stage 5, TECHNICAL_DEBT_REGISTER.md TD-39). All three required together to
# activate the real DocumentIntelligenceProvider; unset = falls back to
# MockDocumentIntelligenceProvider. No real AWS account/IAM credentials exist in this environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Falls back to AWS_REGION if unset -- separate var so Textract can target a specific region
# independent of any other AWS service this app might use later.
AWS_TEXTRACT_REGION=

# ClamAV (Stage 7, commercial-launch execution plan, TECHNICAL_DEBT_REGISTER.md TD-43). Both
# required together to activate real upload content-scanning; unset = falls back to
# MockMalwareScanProvider (always reports clean, logs a loud warning -- MIME-allowlist remains the
# only real protection). Unlike every other vendor above, defaulted ON here rather than left
# blank: ClamAV is free, self-hosted, open-source software (no account/paid signup needed like
# PayFast/Resend/Meta/AWS), and `docker compose up -d clamav` (repo-root docker-compose.yml)
# starts a real local instance with zero external dependency -- first start takes a few minutes
# while it downloads virus definitions. Comment these out if you don't want to run the container.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Mapbox PUBLIC token (starts pk.*) -- deliberately NOT a secret, safe in client-side code by
# Mapbox's own design. Drives both the Owner Dashboard's real property map (PropertyMap.tsx) and
# server-side geocoding-on-save (lib/providers/geocoding.ts). Get one free at mapbox.com; add a
# URL restriction in the Mapbox account dashboard for production. Unset = the map/geocoding
# features degrade to their honest "not available" state, nothing breaks.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

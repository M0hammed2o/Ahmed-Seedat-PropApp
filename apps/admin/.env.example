# Demo mode drives the entire dashboard from realistic mock data — no Supabase project
# required, and login accepts any credentials. BOTH variables below are required to activate it
# (SECURITY.md "Demo-mode auth bypass" — fixed 2026-07-30, PRODUCTION_READINESS_REPORT.md R-01).
# ALLOW_DEMO_MODE is an infra-level-only gate: it is fine here in a LOCAL .env file, but must
# NEVER be set in any staging/production hosting-platform environment configuration.
NEXT_PUBLIC_DEMO_MODE=true
ALLOW_DEMO_MODE=true

# Base URL used to build links inside outbound emails (invite acceptance, password reset). No
# hosting platform is chosen yet -- set to the real deployed origin once one is.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://TO_BE_CONFIRMED.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TO_BE_CONFIRMED
# Server-only — never prefix with NEXT_PUBLIC_, never send to the browser (SECURITY.md).
SUPABASE_SERVICE_ROLE_KEY=TO_BE_CONFIRMED
ADMIN_SESSION_COOKIE_SECRET=CHANGE_ME_32_CHAR_MINIMUM_RANDOM_VALUE
REVENUECAT_WEBHOOK_SECRET=
DOCUMENT_INTELLIGENCE_WEBHOOK_SECRET=
# Bearer secret for the production scheduler to call /api/v1/system/** job-runner endpoints
# without a platform-admin session. Leave unset in local/dev — those endpoints still work via an
# authenticated super_admin session with no secret configured.
CRON_JOB_SECRET=

# Mapbox PUBLIC token (starts pk.*) -- deliberately NOT a secret, safe in client-side code by
# Mapbox's own design. Drives both the Owner Dashboard's real property map (PropertyMap.tsx) and
# server-side geocoding-on-save (lib/providers/geocoding.ts). Get one free at mapbox.com; add a
# URL restriction in the Mapbox account dashboard for production. Unset = the map/geocoding
# features degrade to their honest "not available" state, nothing breaks.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

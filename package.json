{
  "name": "propvault",
  "private": true,
  "version": "0.1.0",
  "description": "PropVault - personal property document vault and payment-tracking SaaS (monorepo)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5 <0.36",
      "postcss": ">=8.5.23 <9",
      "uuid@<11.1.1": ">=11.1.1",
      "shell-quote@<1.11.0": ">=1.11.0",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": ">=0.9.12 <0.10",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "source-map-js@<1.2.2": ">=1.2.2 <2"
    },
    "patchedDependencies": {
      "error-stack-parser": "patches/error-stack-parser.patch"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}

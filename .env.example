# Root environment specification.
# Copy to .env for local tooling that reads the repo root (rare).
# Each app (apps/mobile, apps/admin) and supabase/functions has its own .env.example
# with the variables that specific runtime actually needs. See ENVIRONMENT.md for
# the full, authoritative list, ownership, and rotation notes.

# Shared Supabase project reference used by the Supabase CLI (`supabase link`).
SUPABASE_PROJECT_REF=TO_BE_CONFIRMED

# PRODUCT DECISION 1 (2026-08-03): Google/Apple OAuth. Read by the Supabase CLI's `env(...)`
# interpolation in supabase/config.toml ([auth.external.google]/[auth.external.apple]) -- NOT
# consumed directly by apps/admin (the Next.js app never sees these; it only ever calls
# supabase.auth.signInWithOAuth({provider}), Supabase's own backend does the OAuth exchange using
# whichever credentials the project -- local via these vars, or hosted via the Supabase
# Dashboard -- is configured with). Both providers are `enabled = false` in config.toml until
# real values exist here; see AUTHENTICATION.md for the full external setup walkthrough
# (Google Cloud OAuth consent screen + client, Apple Developer Services ID + key).
GOOGLE_OAUTH_CLIENT_ID=TO_BE_CONFIRMED
GOOGLE_OAUTH_CLIENT_SECRET=TO_BE_CONFIRMED
APPLE_OAUTH_CLIENT_ID=TO_BE_CONFIRMED
APPLE_OAUTH_CLIENT_SECRET=TO_BE_CONFIRMED
